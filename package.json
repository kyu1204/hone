{
  "name": "hone-eval",
  "version": "0.1.0",
  "description": "Evaluate. Correct. Sharpen. A terminal-first evaluation tool for RAG, agents, LLM QA and coding-agent harnesses.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyu1204/hone.git"
  },
  "homepage": "https://github.com/kyu1204/hone",
  "keywords": ["eval", "evaluation", "llm", "agents", "rag", "tui", "benchmark", "judge", "claude-code"],
  "type": "module",
  "bin": {
    "hone": "dist/cli.js"
  },
  "main": "src/index.ts",
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx", "docs", "!docs/work-orders", "skills", "README.md", "LICENSE", "NOTICE"],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun build src/cli.ts --target=bun --packages external --outfile=dist/cli.js && chmod +x dist/cli.js",
    "build:binaries": "bun scripts/build-binaries.ts",
    "release:check": "bun scripts/release-check.ts",
    "docs:cli": "bun scripts/gen-cli-docs.ts",
    "docs:links": "bun scripts/check-links.ts",
    "test": "bun test",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19",
    "oxlint": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@opentui/core": "0.6.0",
    "@opentui/react": "0.6.0",
    "@opentui/ssh": "0.6.0",
    "react": "19.3.0"
  }
}
